{
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Image": {
        "additionalProperties": false,
        "description": "An image shown on the public site.",
        "properties": {
          "alt": {
            "title": "Alt",
            "type": "string"
          },
          "height": {
            "exclusiveMinimum": 0.0,
            "title": "Height",
            "type": "integer"
          },
          "url": {
            "description": "Absolute URL.",
            "title": "Url",
            "type": "string"
          },
          "width": {
            "exclusiveMinimum": 0.0,
            "title": "Width",
            "type": "integer"
          }
        },
        "required": [
          "url",
          "width",
          "height",
          "alt"
        ],
        "title": "Image",
        "type": "object"
      },
      "Lang": {
        "enum": [
          "fr",
          "ar"
        ],
        "title": "Lang",
        "type": "string"
      },
      "ProjectDetail": {
        "additionalProperties": false,
        "description": "A project page: everything in the summary, plus the full content.",
        "properties": {
          "description": {
            "title": "Description",
            "type": "string"
          },
          "photos": {
            "items": {
              "$ref": "#/components/schemas/Image"
            },
            "title": "Photos",
            "type": "array"
          },
          "published_at": {
            "format": "date-time",
            "title": "Published At",
            "type": "string"
          },
          "slug": {
            "title": "Slug",
            "type": "string"
          },
          "summary": {
            "title": "Summary",
            "type": "string"
          },
          "thumbnail": {
            "$ref": "#/components/schemas/Image"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "video": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Video"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "slug",
          "title",
          "summary",
          "thumbnail",
          "published_at",
          "description",
          "video",
          "photos"
        ],
        "title": "ProjectDetail",
        "type": "object"
      },
      "ProjectPage": {
        "additionalProperties": false,
        "description": "Published projects, newest first.",
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/ProjectSummary"
            },
            "title": "Items",
            "type": "array"
          },
          "page": {
            "title": "Page",
            "type": "integer"
          },
          "page_size": {
            "title": "Page Size",
            "type": "integer"
          },
          "total": {
            "title": "Total",
            "type": "integer"
          }
        },
        "required": [
          "items",
          "page",
          "page_size",
          "total"
        ],
        "title": "ProjectPage",
        "type": "object"
      },
      "ProjectSummary": {
        "additionalProperties": false,
        "description": "A project as shown in the portfolio grid.",
        "properties": {
          "published_at": {
            "format": "date-time",
            "title": "Published At",
            "type": "string"
          },
          "slug": {
            "title": "Slug",
            "type": "string"
          },
          "summary": {
            "title": "Summary",
            "type": "string"
          },
          "thumbnail": {
            "$ref": "#/components/schemas/Image"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "slug",
          "title",
          "summary",
          "thumbnail",
          "published_at"
        ],
        "title": "ProjectSummary",
        "type": "object"
      },
      "Service": {
        "additionalProperties": false,
        "properties": {
          "description": {
            "title": "Description",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "slug": {
            "title": "Slug",
            "type": "string"
          }
        },
        "required": [
          "slug",
          "name",
          "description"
        ],
        "title": "Service",
        "type": "object"
      },
      "ServiceList": {
        "additionalProperties": false,
        "description": "All published services, in display order.",
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/Service"
            },
            "title": "Items",
            "type": "array"
          }
        },
        "required": [
          "items"
        ],
        "title": "ServiceList",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "Video": {
        "additionalProperties": false,
        "properties": {
          "embed_url": {
            "description": "Ready to use as <iframe src>. YouTube uses youtube-nocookie.com.",
            "title": "Embed Url",
            "type": "string"
          },
          "provider": {
            "$ref": "#/components/schemas/VideoProvider"
          },
          "video_id": {
            "title": "Video Id",
            "type": "string"
          }
        },
        "required": [
          "provider",
          "video_id",
          "embed_url"
        ],
        "title": "Video",
        "type": "object"
      },
      "VideoProvider": {
        "enum": [
          "youtube",
          "vimeo"
        ],
        "title": "VideoProvider",
        "type": "string"
      }
    }
  },
  "info": {
    "title": "VINIVIDIVICI API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/health/live": {
      "get": {
        "description": "The process is running. It does not check the database (that is /health/ready).",
        "operationId": "live",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Live",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Live",
        "tags": [
          "health"
        ]
      }
    },
    "/api/health/ready": {
      "get": {
        "description": "The API can serve traffic: the database answers.",
        "operationId": "ready",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Ready",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Ready",
        "tags": [
          "health"
        ]
      }
    },
    "/api/v1/projects": {
      "get": {
        "operationId": "list_projects",
        "parameters": [
          {
            "description": "Language of the returned texts.",
            "in": "query",
            "name": "lang",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/Lang",
              "default": "fr",
              "description": "Language of the returned texts."
            }
          },
          {
            "description": "Page number, starting at 1.",
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "default": 1,
              "description": "Page number, starting at 1.",
              "minimum": 1,
              "title": "Page",
              "type": "integer"
            }
          },
          {
            "description": "Items per page.",
            "in": "query",
            "name": "page_size",
            "required": false,
            "schema": {
              "default": 20,
              "description": "Items per page.",
              "maximum": 50,
              "minimum": 1,
              "title": "Page Size",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectPage"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List Projects",
        "tags": [
          "vini"
        ]
      }
    },
    "/api/v1/projects/{slug}": {
      "get": {
        "operationId": "get_project",
        "parameters": [
          {
            "description": "URL-friendly name, e.g. sac-camera-urbain.",
            "in": "path",
            "name": "slug",
            "required": true,
            "schema": {
              "description": "URL-friendly name, e.g. sac-camera-urbain.",
              "maxLength": 100,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "title": "Slug",
              "type": "string"
            }
          },
          {
            "description": "Language of the returned texts.",
            "in": "query",
            "name": "lang",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/Lang",
              "default": "fr",
              "description": "Language of the returned texts."
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectDetail"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Project",
        "tags": [
          "vini"
        ]
      }
    },
    "/api/v1/services": {
      "get": {
        "operationId": "list_services",
        "parameters": [
          {
            "description": "Language of the returned texts.",
            "in": "query",
            "name": "lang",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/Lang",
              "default": "fr",
              "description": "Language of the returned texts."
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceList"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List Services",
        "tags": [
          "vini"
        ]
      }
    }
  }
}
